# Conexao com o banco. Esse valor e o que funciona com o docker-compose.
# Se voce for rodar fora do docker, troque "banco" por "localhost".
DATABASE_URL="postgresql://drivo:drivo123@banco:5432/drivo?schema=public"

# Porta da API
PORT=3333

# Endereco do front que pode chamar essa API.
# Se voce rodar o front em outra porta, troque aqui tambem.
CORS_ORIGIN="http://localhost:3000"

# Chave usada pra assinar o token JWT. Troque por qualquer texto secreto.
JWT_SECRET="troque_esse_segredo"

# Chave da API do Gemini (pega de graca no https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
